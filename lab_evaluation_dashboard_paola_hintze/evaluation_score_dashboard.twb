            <column caption="Score Bin" datatype="integer" name="[score_bin]" role="dimension" type="ordinal" />
          </datasource-dependencies>
          <filter class="categorical" column="[evaluation.data].[none:model_version:nk]" />
          <filter class="categorical" column="[evaluation.data].[none:category:nk]" />
          <filter class="categorical" column="[evaluation.data].[none:date:nk]" />
          <slices />
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="true" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view />
