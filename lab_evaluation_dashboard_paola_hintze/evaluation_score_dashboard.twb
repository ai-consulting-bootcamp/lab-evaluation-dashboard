<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="18.1" source-build="2026.1.0" source-platform="win" version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user">
  <document-format-change-manifest>
    <ZoneFriendlyName />
    <MarkAnimation />
  </document-format-change-manifest>
  <preferences>
    <preference name="ui.encoding.shelf.height" value="24" />
  </preferences>
  <datasources>
    <datasource caption="Evaluation Data" inline="true" name="evaluation.data" version="18.1">
      <connection class="textscan" directory="data" filename="evaluation_data_clean.csv" header="yes" locale="en_US" separator=",">
        <relation name="evaluation_data_clean.csv" table="[evaluation_data_clean.csv]" type="table">
          <columns header="yes">
            <column datatype="integer" name="evaluation_id" ordinal="0" />
            <column datatype="string" name="category" ordinal="1" />
            <column datatype="real" name="score" ordinal="2" />
            <column datatype="string" name="model_version" ordinal="3" />
            <column datatype="date" name="date" ordinal="4" />
            <column datatype="string" name="score_band" ordinal="5" />
            <column datatype="integer" name="score_bin" ordinal="6" />
          </columns>
        </relation>
      </connection>
      <column caption="Evaluation Id" datatype="integer" name="[evaluation_id]" role="dimension" type="nominal" />
      <column caption="Category" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Score" datatype="real" name="[score]" role="measure" type="quantitative" />
      <column caption="Model Version" datatype="string" name="[model_version]" role="dimension" type="nominal" />
      <column caption="Date" datatype="date" name="[date]" role="dimension" type="ordinal" />
      <column caption="Score Band" datatype="string" name="[score_band]" role="dimension" type="nominal" />
      <column caption="Score Bin" datatype="integer" name="[score_bin]" role="dimension" type="ordinal" />
    </datasource>
    <datasource caption="Judge Agreement Data" inline="true" name="agreement.data" version="18.1">
      <connection class="textscan" directory="data" filename="judge_agreement_data.csv" header="yes" locale="en_US" separator=",">
        <relation name="judge_agreement_data.csv" table="[judge_agreement_data.csv]" type="table">
          <columns header="yes">
            <column datatype="integer" name="evaluation_id" ordinal="0" />
            <column datatype="string" name="category" ordinal="1" />
            <column datatype="real" name="judge_1_score" ordinal="2" />
            <column datatype="real" name="judge_2_score" ordinal="3" />
            <column datatype="real" name="score_difference" ordinal="4" />
            <column datatype="integer" name="difference_bin" ordinal="5" />
            <column datatype="integer" name="agreement" ordinal="6" />
            <column datatype="date" name="date" ordinal="7" />
          </columns>
        </relation>
      </connection>
      <column caption="Evaluation Id" datatype="integer" name="[evaluation_id]" role="dimension" type="nominal" />
      <column caption="Category" datatype="string" name="[category]" role="dimension" type="nominal" />
      <column caption="Judge 1 Score" datatype="real" name="[judge_1_score]" role="measure" type="quantitative" />
      <column caption="Judge 2 Score" datatype="real" name="[judge_2_score]" role="measure" type="quantitative" />
      <column caption="Score Difference" datatype="real" name="[score_difference]" role="measure" type="quantitative" />
      <column caption="Difference Bin" datatype="integer" name="[difference_bin]" role="dimension" type="ordinal" />
      <column caption="Agreement" datatype="integer" name="[agreement]" role="measure" type="quantitative" />
      <column caption="Date" datatype="date" name="[date]" role="dimension" type="ordinal" />
    </datasource>
  </datasources>
  <actions>
    <action caption="Filter dashboard by selected category" name="[Action1_9a5e7c4b2d1f403a8b6c5d4e3f2a1098]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Model Evaluation Score Dashboard" type="sheet" worksheet="Category Performance Comparison" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Category Performance Comparison" />
        <param name="special-fields" value="all" />
        <param name="target" value="Model Evaluation Score Dashboard" />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name="Score Distribution">
      <table>
        <view>
          <datasources>
            <datasource caption="Evaluation Data" name="evaluation.data" />
          </datasources>
          <datasource-dependencies datasource="evaluation.data">
            <column-instance column="[evaluation_id]" derivation="None" name="[none:evaluation_id:nk]" pivot="key" type="nominal" />
            <column caption="Evaluation Id" datatype="integer" name="[evaluation_id]" role="dimension" type="nominal" />
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal" />
