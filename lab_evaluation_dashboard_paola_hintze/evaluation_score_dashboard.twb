      <zones>
        <zone h="100000" id="1" param="vert" type-v2="layout-basic" w="100000" x="0" y="0" friendly-name="V-Outer">
          <zone fixed-size="72" id="2" is-fixed="true" type-v2="text" friendly-name="Header">
            <formatted-text>
              <run bold="true" fontcolor="#ffffff" fontname="Tableau Semibold" fontsize="18">Model Evaluation Score Dashboard</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#e7ecf2" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="0" />
              <format attr="background-color" value="#13263d" />
            </zone-style>
          </zone>
          <zone id="3" param="horz" type-v2="layout-flow" friendly-name="H-Body">
            <zone fixed-size="210" id="4" is-fixed="true" param="vert" type-v2="layout-flow" friendly-name="V-Filters">
              <zone fixed-size="72" id="5" is-fixed="true" mode="checkdropdown" name="Score Distribution" param="[evaluation.data].[none:model_version:nk]" show-all="true" type-v2="filter" friendly-name="Filter model_version">
                <zone-style>
                  <format attr="border-color" value="#e7ecf2" />
                  <format attr="border-style" value="solid" />
                  <format attr="border-width" value="1" />
                  <format attr="margin" value="4" />
                  <format attr="background-color" value="#ffffff" />
